# Copie ce fichier en « .env.local » pour lancer l'appli sur ton ordinateur avec ta base Supabase.
# Sans ces deux lignes, l'appli démarre en « mode local » : les comptes restent sur l'appareil, sans synchronisation.
# Où les trouver : Supabase > ton projet > bouton « Connect » (ou Project Settings > API Keys).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=colle-ici-ta-cle-publishable-ou-anon
